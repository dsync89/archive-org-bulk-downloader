<Window x:Class="ArchiveOrgCollectionSync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ArchiveOrgCollectionSync"
    mc:Ignorable="d"
    Title="Archive.org Bulk Downloader"
    Height="700"
    Width="1080"
    MinHeight="480"
    MinWidth="780"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip" Icon="/archive.ico"
    Closing="Window_Closing">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <Style x:Key="FilterButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="GroupName" Value="FileFilter" />
        </Style>
        <Style x:Key="LevelToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="CheckButton" TargetType="Button">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="Tabs" Margin="15,10,15,10" Grid.Row="0">
            <TabItem Header="Sync">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">Collection URL:</TextBlock>
                        <TextBox x:Name="UrlTextBox" Grid.Row="0" Grid.Column="1" Padding="3" Margin="0,0,10,0" MaxLines="1" TextChanged="TextBox_TextChanged" />
                        <Button x:Name="PasteButton" Grid.Row="0" Grid.Column="2" Click="PasteButton_Click">Paste</Button>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,10,0">Destination Folder:</TextBlock>
                        <TextBox x:Name="FolderTextBox" Grid.Row="1" Grid.Column="1" Padding="3" Margin="0,8,10,0" MaxLines="1" TextChanged="TextBox_TextChanged" />
                        <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Click="BrowseButton_Click">Browse...</Button>
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,10,0">Link:</TextBlock>
                        <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Button x:Name="SyncButton" DockPanel.Dock="Right" Padding="10,1" Margin="6,0,0,0" IsEnabled="False" Click="SyncButton_Click"
                                ToolTip="Compare archive.org now with your last snapshot of this link: see what was added, removed, renamed or changed, then apply it.">⟳ Sync…</Button>
                            <Button x:Name="LinksButton" DockPanel.Dock="Right" Padding="10,1" Click="LinksButton_Click"
                                ToolTip="Your download links (collection + folder). Pick one to load it.">Links ▾</Button>
                            <TextBlock x:Name="LinkTextBlock" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Grid>
                    <WrapPanel x:Name="OptionsPanel" DockPanel.Dock="Top" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" ToolTip="How many files download at the same time.">Files in parallel:</TextBlock>
                        <local:NumericUpDown x:Name="FilesNumericUpDown" Width="44" Height="26" Margin="6,0,18,0" MinValue="1" MaxValue="16" Value="4"
                            ToolTip="How many files download at the same time." />
                        <TextBlock VerticalAlignment="Center" ToolTip="Ranged HTTP connections per file (files of 32 MB or more). Splits one big file into parallel streams.">Connections per file:</TextBlock>
                        <local:NumericUpDown x:Name="ConnectionsNumericUpDown" Width="44" Height="26" Margin="6,0,18,0" MinValue="1" MaxValue="16" Value="4"
                            ToolTip="Ranged HTTP connections per file (files of 32 MB or more). Splits one big file into parallel streams." />
                        <TextBlock VerticalAlignment="Center">Verify:</TextBlock>
                        <ComboBox x:Name="VerifyComboBox" Width="120" Margin="6,0,18,0" SelectedIndex="0"
                            ToolTip="MD5 checks every existing and downloaded file. Size only is much faster for re-syncs.">
                            <ComboBoxItem>MD5 checksum</ComboBoxItem>
                            <ComboBoxItem>Size only</ComboBoxItem>
                        </ComboBox>
                        <CheckBox x:Name="OriginalsCheckBox" VerticalAlignment="Center" Margin="0,0,18,0" IsChecked="True"
                            ToolTip="Skip files archive.org derived itself (thumbnails, torrents, _meta.xml…)." Content="Originals only" />
                        <CheckBox x:Name="DeleteFilesCheckBox" VerticalAlignment="Center" Content="Delete files not in the collection"
                            ToolTip="Delete files in the destination folder that don't exist in the Archive.org collection." />
                        <CheckBox x:Name="KeepRepacksCheckBox" VerticalAlignment="Center" Margin="18,0,0,0" IsChecked="True" Content="Keep re-zipped files"
                            ToolTip="Sync: when archive.org re-zips a file (new md5) but every file inside is provably the same as yours, keep your copy instead of downloading it again. Untick to always replace changed files." />
                    </WrapPanel>
                    <Border x:Name="ChangeBanner" DockPanel.Dock="Top" Margin="0,10,0,0" Padding="10,6" Visibility="Collapsed"
                        Background="#FFFFF4E0" BorderBrush="#FFE8B04A" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Padding="10,1" Click="BannerReviewButton_Click">Review changes…</Button>
                                <Button Padding="10,1" Margin="6,0,0,0" Click="BannerDismissButton_Click">Dismiss</Button>
                            </StackPanel>
                            <TextBlock x:Name="ChangeBannerTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF7A4A00" />
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,12,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">Search:</TextBlock>
                            <TextBox x:Name="SearchTextBox" Width="200" Padding="2" TextChanged="FileFilter_Changed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" Style="{StaticResource FilterButton}" IsChecked="True" Checked="FileFilter_Changed">All</RadioButton>
                            <RadioButton x:Name="FilterActive" Style="{StaticResource FilterButton}" Checked="FileFilter_Changed">Active</RadioButton>
                            <RadioButton x:Name="FilterQueued" Style="{StaticResource FilterButton}" Checked="FileFilter_Changed">Queued</RadioButton>
                            <RadioButton x:Name="FilterDone" Style="{StaticResource FilterButton}" Checked="FileFilter_Changed">Done</RadioButton>
                            <RadioButton x:Name="FilterSkipped" Style="{StaticResource FilterButton}" Checked="FileFilter_Changed">Skipped</RadioButton>
                            <RadioButton x:Name="FilterFailed" Style="{StaticResource FilterButton}" Checked="FileFilter_Changed">Failed</RadioButton>
                            <RadioButton x:Name="FilterUnchecked" Style="{StaticResource FilterButton}" Checked="FileFilter_Changed"
                                ToolTip="Files you unticked; they are not checked, downloaded or verified.">Unchecked</RadioButton>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel x:Name="CheckPanel" DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock x:Name="CheckedTextBlock" DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">Check:</TextBlock>
                            <Button Style="{StaticResource CheckButton}" Click="CheckAllButton_Click" ToolTip="Tick every file.">All</Button>
                            <Button Style="{StaticResource CheckButton}" Click="CheckNoneButton_Click" ToolTip="Untick every file.">None</Button>
                            <Button Style="{StaticResource CheckButton}" Click="CheckInvertButton_Click" ToolTip="Swap ticked and unticked files.">Invert</Button>
                            <Button Style="{StaticResource CheckButton}" Click="CheckVisibleButton_Click"
                                ToolTip="Tick only the files the current filter and search show; untick the rest. E.g. search &quot;metal&quot;, then click this.">Visible</Button>
                            <Button Style="{StaticResource CheckButton}" Click="CheckHighlightedButton_Click"
                                ToolTip="Tick only the highlighted rows (Ctrl/Shift-click to highlight several); untick the rest.">Highlighted</Button>
                            <Button Style="{StaticResource CheckButton}" Click="CheckMissingButton_Click"
                                ToolTip="Tick only files that aren't in the destination folder yet, are partial, or have a different size there. Size check only; use Verify All for MD5.">Only Missing</Button>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray">Space toggles highlighted rows</TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="FilesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="None" SelectionMode="Extended" CanUserResizeRows="False" CanUserAddRows="False"
                        EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizing="True"
                        RowHeight="22" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        PreviewKeyDown="FilesDataGrid_PreviewKeyDown" PreviewMouseLeftButtonDown="FilesDataGrid_PreviewMouseLeftButtonDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter Property="Foreground" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                        <Setter Property="Foreground" Value="Green" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                        <Setter Property="Foreground" Value="Gray" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                        <Setter Property="Foreground" Value="DarkGray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Check Highlighted" InputGestureText="Space" Click="CheckHighlightedMenuItem_Click" />
                                <MenuItem Header="Uncheck Highlighted" Click="UncheckHighlightedMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="History of This File" Click="HistoryMenuItem_Click"
                                    ToolTip="Every version of this file across your snapshots and archive.org's kept copies (Links tab)." />
                                <MenuItem Header="Open Containing Folder" Click="OpenFolderMenuItem_Click" />
                                <MenuItem Header="Copy Name" Click="CopyNameMenuItem_Click" />
                                <MenuItem Header="Copy Download URL" Click="CopyUrlMenuItem_Click" />
                                <Separator />
                                <MenuItem x:Name="RetrySelectedMenuItem" Header="Retry Selected" Click="RetrySelectedMenuItem_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="30" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="HeaderCheckBox" IsThreeState="False" Click="HeaderCheckBox_Click" Focusable="False"
                                        ToolTip="Tick or untick every file the filter and search show." />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Tag="RowCheck" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="" Binding="{Binding StatusGlyph}" Width="26" SortMemberPath="Status" />
                            <DataGridTextColumn Header="Δ" Binding="{Binding Change}" Width="26" SortMemberPath="Change">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="ToolTip" Value="What changed on archive.org at the last Sync or scan: + added, ~ renamed, ⇄ moved, * changed." />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" SortMemberPath="Size" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTemplateColumn Header="Progress" Width="190" SortMemberPath="Percent">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="16" />
                                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}" Foreground="Black" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="85" SortMemberPath="Speed" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="65" ElementStyle="{StaticResource RightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="LinksTabItem" Header="Links" Selector.Selected="SessionsTabItem_Selected">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="200" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="CheckLinksButton" Padding="8,2" Margin="0,0,4,4" Click="CheckLinksButton_Click"
                                ToolTip="Ask archive.org whether each link's item changed since your last snapshot, and check each folder still exists. A few bytes per link.">Check all for updates</Button>
                            <Button x:Name="LinkOpenButton" Padding="8,2" Margin="0,0,4,4" Click="LinkOpenButton_Click"
                                ToolTip="Put this link's URL and folder on the Sync tab.">Open in Sync tab</Button>
                            <Button x:Name="LinkRelocateButton" Padding="8,2" Margin="0,0,4,4" Click="LinkRelocateButton_Click"
                                ToolTip="You moved the downloaded files: point the link, its runs and its verifications at the new folder. No file is touched.">Relocate…</Button>
                            <Button x:Name="LinkForgetButton" Padding="8,2" Margin="0,0,4,4" Click="LinkForgetButton_Click"
                                ToolTip="Delete this link's snapshots and runs from history. Downloaded files are not touched.">Forget…</Button>
                        </WrapPanel>
                        <DockPanel x:Name="CheckAllPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
                            <Button DockPanel.Dock="Right" Padding="8,1" Margin="6,0,0,0" Click="CheckAllCancelButton_Click">Cancel</Button>
                            <StackPanel>
                                <ProgressBar x:Name="CheckAllProgressBar" Height="12" Maximum="1000" />
                                <TextBlock x:Name="CheckAllTextBlock" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                            Text="● up to date  ▲ changed on archive.org  ? not synced yet  ✖ folder or item missing" />
                        <ListBox x:Name="LinksListBox" SelectionChanged="LinksListBox_SelectionChanged" HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LinksListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
                    <DockPanel Grid.Column="2">
                        <TextBlock x:Name="LinkHeaderTextBlock" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                        <TabControl x:Name="LinkTabs">
                            <TabItem Header="Runs">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="SessionOpenButton" Style="{StaticResource BarButton}" Margin="0" Click="SessionOpenButton_Click"
                            ToolTip="Load this session's file list and log without downloading.">Open</Button>
                        <Button x:Name="SessionResumeButton" Style="{StaticResource BarButton}" Click="SessionResumeButton_Click"
                            ToolTip="Continue queued and partially downloaded files.">Resume</Button>
                        <Button x:Name="SessionRetryButton" Style="{StaticResource BarButton}" Click="SessionRetryButton_Click">Retry Failed</Button>
                        <Button x:Name="SessionRerunButton" Style="{StaticResource BarButton}" Click="SessionRerunButton_Click"
                            ToolTip="Start a new session with the same URL, folder and options (rescans the collection).">Re-run</Button>
                        <Button x:Name="SessionExportButton" Style="{StaticResource BarButton}" Click="SessionExportButton_Click">Export CSV...</Button>
                        <Button x:Name="SessionLogButton" Style="{StaticResource BarButton}" Click="SessionLogButton_Click">Open Log</Button>
                        <Button x:Name="SessionDeleteButton" Style="{StaticResource BarButton}" Click="SessionDeleteButton_Click">Delete</Button>
                        <Button Style="{StaticResource BarButton}" Click="SessionsFolderButton_Click">Sessions Folder</Button>
                    </WrapPanel>
                    <ListView x:Name="SessionsListView" SelectionMode="Single" MouseDoubleClick="SessionsListView_MouseDoubleClick"
                        SelectionChanged="SessionsListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="When" DisplayMemberBinding="{Binding WhenText}" Width="120" />
                                <GridViewColumn Header="Collection" DisplayMemberBinding="{Binding Collection}" Width="150" />
                                <GridViewColumn Header="Destination" DisplayMemberBinding="{Binding Folder}" Width="190" />
                                <GridViewColumn Header="Files" DisplayMemberBinding="{Binding FilesText}" Width="110" />
                                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeText}" Width="80" />
                                <GridViewColumn Header="Downloaded" DisplayMemberBinding="{Binding DownloadedText}" Width="85" />
                                <GridViewColumn Header="Avg Speed" DisplayMemberBinding="{Binding SpeedText}" Width="85" />
                                <GridViewColumn Header="Result" DisplayMemberBinding="{Binding ResultText}" Width="100" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                            </TabItem>
                            <TabItem x:Name="SnapshotsTabItem" Header="Snapshots">
                                <DockPanel Margin="6">
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Button x:Name="SnapshotComparePreviousButton" Padding="8,2" Margin="0,0,4,0" Click="SnapshotComparePreviousButton_Click"
                                            ToolTip="Open the Diff tab with the snapshot before this one as A and this one as B.">Compare with previous</Button>
                                        <Button x:Name="SnapshotCompareLiveButton" Padding="8,2" Margin="0,0,4,0" Click="SnapshotCompareLiveButton_Click"
                                            ToolTip="Open the Diff tab with this snapshot as A and archive.org now as B.">Compare with archive.org now</Button>
                                        <Button x:Name="SnapshotExportButton" Padding="8,2" Margin="0,0,4,0" Click="SnapshotExportButton_Click"
                                            ToolTip="Save this snapshot's file list (name, size, MD5, SHA-1, CRC32, upload time) as CSV.">Export CSV…</Button>
                                    </WrapPanel>
                                    <TextBlock x:Name="SnapshotsInfoTextBlock" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <ListView x:Name="SnapshotsListView" SelectionMode="Single" MouseDoubleClick="SnapshotComparePreviousButton_Click">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="#" DisplayMemberBinding="{Binding Number}" Width="36" />
                                                <GridViewColumn Header="When" DisplayMemberBinding="{Binding When}" Width="120" />
                                                <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="110" />
                                                <GridViewColumn Header="Files" DisplayMemberBinding="{Binding Files}" Width="50" />
                                                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="80" />
                                                <GridViewColumn Header="Δ vs previous" DisplayMemberBinding="{Binding Delta}" Width="320" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </TabItem>
                            <TabItem x:Name="DiffTabItem" Header="Diff">
                                <DockPanel Margin="6">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">A</TextBlock>
                                            <ComboBox x:Name="DiffAComboBox" Width="220" DisplayMemberPath="Label" />
                                            <TextBlock VerticalAlignment="Center" Margin="8,0">→  B</TextBlock>
                                            <ComboBox x:Name="DiffBComboBox" Width="220" DisplayMemberPath="Label" />
                                            <Button x:Name="DiffCompareButton" Padding="12,1" Margin="8,0,0,0" Click="DiffCompareButton_Click">Compare</Button>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel x:Name="DiffProgressPanel" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed">
                                        <Button DockPanel.Dock="Right" Padding="8,1" Margin="6,0,0,0" Click="DiffCancelButton_Click">Cancel</Button>
                                        <ProgressBar x:Name="DiffProgressBar" DockPanel.Dock="Right" Width="200" Height="12" Maximum="1000" IsIndeterminate="True" />
                                        <TextBlock x:Name="DiffProgressTextBlock" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">Search:</TextBlock>
                                        <TextBox x:Name="DiffSearchTextBox" Width="160" Padding="2" TextChanged="DiffFilter_Changed" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="DiffShowAdded" Margin="0,0,12,0" IsChecked="True" Click="DiffFilter_Changed">+ added</CheckBox>
                                        <CheckBox x:Name="DiffShowRemoved" Margin="0,0,12,0" IsChecked="True" Click="DiffFilter_Changed">− removed</CheckBox>
                                        <CheckBox x:Name="DiffShowRenamed" Margin="0,0,12,0" IsChecked="True" Click="DiffFilter_Changed">~ renamed</CheckBox>
                                        <CheckBox x:Name="DiffShowMoved" Margin="0,0,12,0" IsChecked="True" Click="DiffFilter_Changed">⇄ moved</CheckBox>
                                        <CheckBox x:Name="DiffShowChanged" Margin="0,0,12,0" IsChecked="True" Click="DiffFilter_Changed">* changed</CheckBox>
                                        <CheckBox x:Name="DiffShowTouched" Margin="0,0,12,0" IsChecked="False" Click="DiffFilter_Changed">· touched</CheckBox>
                                    </WrapPanel>
                                    </DockPanel>
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Button x:Name="DiffHistoryButton" Padding="8,2" Margin="0,0,4,0" Click="DiffHistoryButton_Click"
                                            ToolTip="Show every version of the selected file.">History of selected file</Button>
                                        <Button x:Name="DiffExportButton" Padding="8,2" Margin="0,0,4,0" Click="DiffExportButton_Click">Export CSV…</Button>
                                        <Button x:Name="DiffSyncButton" Padding="8,2" Margin="0,0,4,0" Click="DiffSyncButton_Click"
                                            ToolTip="Open ⟳ Sync for this link to apply what changed since your last snapshot.">⟳ Sync this link…</Button>
                                        <TextBlock x:Name="DiffSummaryTextBlock" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" />
                                    </WrapPanel>
                                    <DataGrid x:Name="DiffFoldersDataGrid" DockPanel.Dock="Top" Height="100" Margin="0,0,0,6" AutoGenerateColumns="False" IsReadOnly="True"
                                        HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" CanUserAddRows="False"
                                        SelectionChanged="DiffFoldersDataGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderText}" Width="*" />
                                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="55" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTextColumn Header="+" Binding="{Binding Added}" Width="38" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTextColumn Header="−" Binding="{Binding Removed}" Width="38" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTextColumn Header="~" Binding="{Binding Renamed}" Width="38" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTextColumn Header="⇄" Binding="{Binding Moved}" Width="38" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTextColumn Header="*" Binding="{Binding Changed}" Width="38" ElementStyle="{StaticResource RightCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid x:Name="DiffRowsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE6E6E6" SelectionMode="Single" CanUserAddRows="False"
                                        EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="DiffHistoryButton_Click">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Δ" Binding="{Binding Glyph}" Width="26" SortMemberPath="Kind" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding NameText}" Width="*" SortMemberPath="Name" />
                                            <DataGridTextColumn Header="A" Binding="{Binding AText}" Width="160" />
                                            <DataGridTextColumn Header="B" Binding="{Binding BText}" Width="160" />
                                            <DataGridTextColumn Header="Local" Binding="{Binding LocalText}" Width="80" SortMemberPath="Local" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem x:Name="FileHistoryTabItem" Header="File history">
                                <DockPanel Margin="6">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button x:Name="FileHistoryShowButton" DockPanel.Dock="Right" Padding="12,1" Margin="6,0,0,0" Click="FileHistoryShowButton_Click" IsDefault="False">Show</Button>
                                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0">File:</TextBlock>
                                        <ComboBox x:Name="FileHistoryComboBox" IsEditable="True" IsTextSearchEnabled="True"
                                            ToolTip="Pick or type a file name as archive.org lists it, e.g. TeknoParrot Collection/Game.zip" />
                                    </DockPanel>
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Button x:Name="FileHistoryDownloadButton" Padding="8,2" Margin="0,0,4,0" Click="FileHistoryDownloadButton_Click"
                                            ToolTip="Open the selected archive.org kept copy (history/files/…) in your browser to download it.">Download kept copy…</Button>
                                        <Button Padding="8,2" Margin="0,0,4,0" Click="FileHistoryCopyButton_Click">Copy</Button>
                                        <TextBlock x:Name="FileHistoryInfoTextBlock" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" TextWrapping="Wrap" />
                                    </WrapPanel>
                                    <ListView x:Name="FileHistoryListView" SelectionMode="Single">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="When" DisplayMemberBinding="{Binding When}" Width="110" />
                                                <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="200" />
                                                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeText}" Width="70" />
                                                <GridViewColumn Header="Local" DisplayMemberBinding="{Binding Local}" Width="95" />
                                                <GridViewColumn Header="Runs" DisplayMemberBinding="{Binding Note}" Width="200" />
                                                <GridViewColumn Header="Uploaded" DisplayMemberBinding="{Binding Uploaded}" Width="110" />
                                                <GridViewColumn Header="MD5" DisplayMemberBinding="{Binding Md5}" Width="250" />
                                                <GridViewColumn Header="SHA-1" DisplayMemberBinding="{Binding Sha1}" Width="300" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Log" Selector.Selected="LogTabItem_Selected">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox x:Name="AutoScrollCheckBox" VerticalAlignment="Center" IsChecked="True" Margin="0,0,10,0">Auto-scroll</CheckBox>
                            <Button Style="{StaticResource BarButton}" MinWidth="60" Click="LogCopyButton_Click">Copy</Button>
                            <Button Style="{StaticResource BarButton}" MinWidth="60" Click="LogSaveButton_Click">Save...</Button>
                            <Button Style="{StaticResource BarButton}" MinWidth="60" Click="LogClearButton_Click">Clear</Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="LogDebugToggle" Style="{StaticResource LevelToggle}" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"
                                ToolTip="Per-file details such as skipped files.">Debug</ToggleButton>
                            <ToggleButton x:Name="LogInfoToggle" Style="{StaticResource LevelToggle}" IsChecked="True" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed">Info</ToggleButton>
                            <ToggleButton x:Name="LogWarnToggle" Style="{StaticResource LevelToggle}" IsChecked="True" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed">Warn</ToggleButton>
                            <ToggleButton x:Name="LogErrorToggle" Style="{StaticResource LevelToggle}" IsChecked="True" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed">Error</ToggleButton>
                            <TextBlock VerticalAlignment="Center" Margin="10,0,6,0">Search:</TextBlock>
                            <TextBox x:Name="LogSearchTextBox" Width="200" Padding="2" TextChanged="LogFilter_Changed" />
                        </StackPanel>
                    </DockPanel>
                    <ListView x:Name="LogListView" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{Binding Brush}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss}" Width="70" />
                                <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="60" />
                                <GridViewColumn Header="File" DisplayMemberBinding="{Binding File}" Width="320" />
                                <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="520" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="About">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic">But God showed his great love for us by sending Christ to die for us while we were still sinners. - Romans 5:8 (NLT)</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="Bold">Archive.org Bulk Downloader</TextBlock>
                        <TextBlock x:Name="VersionTextBlock" TextWrapping="Wrap" Margin="0,4,0,0">Version 1.3</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                            Maintained by dsync89:
                            <Hyperlink NavigateUri="https://github.com/dsync89/archive-org-bulk-downloader" RequestNavigate="Hyperlink_RequestNavigate">github.com/dsync89/archive-org-bulk-downloader</Hyperlink>
                            <LineBreak />
                            Parallel, segmented and resumable downloads, file list, sessions and log.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                            Based on Archive.org Collection Sync by Unbroken Software, LLC:
                            <Hyperlink NavigateUri="https://github.com/jasonunbrokensoftware/ArchiveOrgCollectionSync" RequestNavigate="Hyperlink_RequestNavigate">github.com/jasonunbrokensoftware/ArchiveOrgCollectionSync</Hyperlink>
                            <LineBreak />
                            Thank you for the original app.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">MIT License</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">Copyright (c) 2026 dsync89 (Archive.org Bulk Downloader modifications)</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">Copyright (c) 2023 Unbroken Software, LLC (Archive.org Collection Sync)</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the "Software"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="1" Margin="15,0,15,15" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel x:Name="SyncStrip" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Padding="10,1" Margin="6,0,0,0" Click="SyncStripCancelButton_Click">Cancel</Button>
                    <Button DockPanel.Dock="Right" Padding="10,1" Margin="6,0,0,0" Click="SyncStripShowButton_Click" ToolTip="Reopen the Sync window.">⤢ Show</Button>
                    <ProgressBar x:Name="SyncStripProgressBar" DockPanel.Dock="Right" Width="180" Height="14" Margin="10,0,0,0" Maximum="1000" />
                    <TextBlock x:Name="SyncStripTextBlock" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="StatusTextBlock" Grid.Row="0" Grid.Column="0" Margin="0,0,10,6" TextTrimming="CharacterEllipsis">Ready.</TextBlock>
                <TextBlock x:Name="SummaryTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" HorizontalAlignment="Right" />
                <ProgressBar x:Name="ProgressBar" Grid.Row="1" Grid.Column="0" Height="24" Maximum="1000" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                    <Button x:Name="ScanButton" Style="{StaticResource BarButton}" IsEnabled="False" Click="ScanButton_Click"
                        ToolTip="List the collection's files without downloading, so you can tick the ones you want, then press Start.">Scan</Button>
                    <Button x:Name="StartButton" Style="{StaticResource BarButton}" IsEnabled="False" Click="StartButton_Click"
                        ToolTip="Download the ticked files that are missing (scans first when no list is loaded). Files verified in earlier runs are skipped without re-checking; partial downloads resume.">Start</Button>
                    <Button x:Name="VerifyAllButton" Style="{StaticResource BarButton}" IsEnabled="False" Click="VerifyAllButton_Click"
                        ToolTip="MD5-check every ticked file again, ignoring earlier verifications. Slow; use it if you suspect disk corruption.">Verify All</Button>
                    <Button x:Name="PauseButton" Style="{StaticResource BarButton}" IsEnabled="False" Click="PauseButton_Click">Pause</Button>
                    <Button x:Name="StopButton" Style="{StaticResource BarButton}" IsEnabled="False" Click="StopButton_Click">Stop</Button>
                    <Button x:Name="RetryFailedButton" Style="{StaticResource BarButton}" IsEnabled="False" Click="RetryFailedButton_Click">Retry Failed</Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
